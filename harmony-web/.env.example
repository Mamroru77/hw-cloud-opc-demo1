# 云脉·智慧医疗 后端环境变量示例
# 复制为 .env 后填入真实凭证即可启用服务端托管密钥与云端服务

# ===== 外部大模型 API Key（可选，填入后前端无需手动输入 Key 即可走真实 LLM）=====
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
PANGU_API_KEY=
PANGU_API_ENDPOINT=https://infer-modelarts.cn-north-4.myhuaweicloud.com/v1/infers/pangu
GLM_API_KEY=
GEMINI_API_KEY=

# ===== 华为云 CodeArts 流水线与质量报告（可选）=====
CODEARTS_AUTH_TOKEN=
CODEARTS_PROJECT_ID=
CODEARTS_PIPELINE_API_URL=https://codearts-ext.cn-north-4.myhuaweicloud.com/v2/pipelines
CODEARTS_INSIGHT_API_URL=https://codearts-ext.cn-north-4.myhuaweicloud.com/v2/insight
CODEARTS_WEBHOOK_SECRET=

# ===== 华为云知识湖（可选）=====
KNOWLEDGE_LAKE_ENDPOINT=
KNOWLEDGE_LAKE_PROJECT_ID=
KNOWLEDGE_LAKE_KB_ID=
KNOWLEDGE_LAKE_AK=
KNOWLEDGE_LAKE_SK=

# ===== 本地持久化数据库路径（默认 backend/data/cloudvein.db）=====
# CLOUDVEIN_DB_PATH=
